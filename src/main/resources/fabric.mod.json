{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "icon": "curiosfabric_icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.arakiel.curiosfabric.CuriosFabric"
    ],
    "client": [
      "dev.arakiel.curiosfabric.CuriosFabricClient"
    ],
    "modmenu": [
      "dev.arakiel.curiosfabric.client.CuriosFabricModMenu"
    ],
    "gemini:components-entity": [
      "dev.arakiel.curiosfabric.common.capability.CuriosFabricEntityComponents"
    ],
    "jei_mod_plugin": [
      "dev.arakiel.curiosfabric.common.integration.jei.CuriosJeiPlugin"
    ],
    "rei_client": [
      "dev.arakiel.curiosfabric.common.integration.rei.CuriosReiPlugin"
    ],
    "curiosfabric": []
  },
  "mixins": [
    "curiosfabric.api.mixins.json",
    "curiosfabric.core.mixins.json",
    "curiosfabric.compat.mixins.json",
    "curiosfabric.trinkets.mixins.json",
    "curiosfabric.neoforgecurios.mixins.json",
    "curiosfabric.accessories.mixins.json"
  ],
  "accessWidener": "curiosfabric.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "gemini": ">=1.0.5"
  },
  "custom": {
    "gemini:components": [
      "curiosfabric:inventory"
    ]
  },
  "suggests": {
    "accessories": ">=1.1.0-beta.54",
    "emi": "*",
    "jei": "*",
    "modmenu": "*",
    "roughlyenoughitems": "*"
  }
}
